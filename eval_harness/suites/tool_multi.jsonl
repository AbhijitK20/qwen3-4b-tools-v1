{"prompt": "Convert 120 USD to EUR, then send the result amount to my colleague as a payment.", "tools": ["convert_currency", "send_payment"], "expect": [{"name": "convert_currency", "args": {"amount": 120, "from": "USD", "to": "EUR"}}, {"name": "send_payment", "args": {"amount": null}}]}
