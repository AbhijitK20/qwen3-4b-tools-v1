{"prompt": "Find the cheapest flight from Delhi to Berlin on 2026-11-05 and reserve a hotel for 2 nights.", "tools": ["search_flights", "book_hotel"], "expect": [{"name": "search_flights", "args": {"origin": "Delhi", "destination": "Berlin", "date": "2026-11-05"}}, {"name": "book_hotel", "args": {"nights": 2}}]}
{"prompt": "Check my account balance, then transfer 50 GBP to account 99887766.", "tools": ["get_balance", "transfer_funds"], "expect": [{"name": "get_balance", "args": {}}, {"name": "transfer_funds", "args": {"amount": 50, "currency": "GBP", "to_account": "99887766"}}]}
