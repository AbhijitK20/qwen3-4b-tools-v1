{"prompt": "Get the current stock price of NVDA and create a price alert at 10% above it.", "tools": ["get_stock_price", "create_alert"], "expect": [{"name": "get_stock_price", "args": {"ticker": "NVDA"}}, {"name": "create_alert", "args": {"ticker": "NVDA"}}]}
{"prompt": "Translate this sentence to French and then email it to maria@example.com.", "tools": ["translate", "send_email"], "expect": [{"name": "translate", "args": {"to": "fr"}}, {"name": "send_email", "args": {"to": "maria@example.com"}}]}
{"prompt": "Look up order 55231 and refund it if it was delivered more than 30 days ago.", "tools": ["get_order", "refund_order"], "expect": [{"name": "get_order", "args": {"order_id": "55231"}}, {"name": "refund_order", "args": {"order_id": "55231"}}]}
